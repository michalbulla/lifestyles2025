{% extends "_layouts/base" %}
{% set uri = entry.uri|default('blog') %}
{% set pageHeading = entry.pageHeading|default(entry.title) %}

{% set bodyClass = "home-page" %}

{% set showSidebar = true %}

{% block pageLayout %}
  {% embed '_layouts/page/homePage' %}
    {% block contentLayout %}
      {% embed '_layouts/content/default' %}

        {% block mainContent %}
          {% cache %}
          <div class="intro-section">
            <div class="container">
              <div class="intro">
                <h1>Lifestyles</h1>
                {{ entry.intro }}
              </div>
            </div>
          </div>
            <div class="container">
              <h2>Vyberte si Váš Lifestyles produkt</h2>
            </div>
            {% set kategorie = craft.entries.section('pages').level(1) %}
            {% if kategorie|length %}
              <div class="list">
                <div class="container">
                  {% for kategoria in kategorie %}
                    <div class="list-item">
                      <div class="list-image">
                        <a href="{{ kategoria.url }}">
                          <img src="{{ kategoria.obrazok.one.url('imageMedium') }}" alt="{{ kategoria.obrazok.title }}">
                        </a>
                      </div>
                      <div class="list-info">
                        <h2><a href="{{ kategoria.url }}">{{ kategoria.pageHeading }}</a></h2>
                        <p>{{ kategoria.kratkyPopis }}</p>
                        {% if kategoria.vyhody|length %}
                          <ul>
                            {% for vyhoda in kategoria.vyhody %}
                              <li>
                                {{ vyhoda.vyhody }}
                              </li>
                            {% endfor %}
                          {% endif %}
                        </ul>
                        <div class="btn-wrap side-by-side">
                          <a href="{{ kategoria.url }}" class="btn">Čítaj viac</a>
                        </div>
                        <div class="btn-wrap side-by-side">
                          <a href="{{ kategoria.shopUrl }}" target="_blank" class="btn shop">eShop</a>
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          {% endcache %}
          {% include "_partials/carouselJs" %}
        {% endblock %}
      {% endembed %}
    {% endblock %}
  {% endembed %}
{% endblock %}
