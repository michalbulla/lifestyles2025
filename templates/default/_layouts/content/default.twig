<div class="page">
  <div class="content">
    <div class="main-content" id="main-content-start">
      {% block mainContent %}
        {% cache %}
          <div class="default-content">
            <div class="container">
              {% include '_partials/contentBuilder' with {contentField: entry.mainContent, blocksDir: 'mainContent'} %}
            </div>
          </div>
        {% endcache %}
      {% endblock %}
    </div>
  </div>
</div>
