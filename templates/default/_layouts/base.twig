<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {# Specify the Hreflang Tag #}
  <link rel="alternate" hreflang="en" href="{{ siteUrl|trim('/', 'right') }}">

  {# Render the SEO output #}
  {% hook 'seomateMeta' %}
  {% include '_shared/analytics' %}

  {# Custom Fonts #}
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&display=swap" rel="stylesheet"> 
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet"> 
  <link href="https://fonts.googleapis.com/css2?family=Caveat&display=swap" rel="stylesheet"> 

  {# Favorite Icons #}
  {# Link to the favicons process:
  https://docs.google.com/document/d/1tfcjhdlop5TVMAuf5tRVrpnLC3XcgR8sPCRJZu5RyvA/edit#heading=h.o81pnonmirdd #}
  {# {% include '_partials/favicon' %} #}

  {# Include all CSS collected through 'css' and 'view.registerCssFile(url)' #}
  {{ head() }}

  {# Compiled and minified Bootstrap CSS v3.3.5 #}
  <link rel="stylesheet" href="//d3gex2kmk7v5nh.cloudfront.net/bootstrap/css/bootstrap2018.min.css">

  {# Minified Swiper CSS v4.0.5 #}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.0.5/css/swiper.min.css">

  {# Font Awesome 4.7.0 - Using customized FontAwesome CDN #}
  <link rel="stylesheet" href="https://use.fontawesome.com/d0f0372061.css">

  <!-- Custom styles for this template -->
  <link href="{{ craft.tungsten.assetUrl('styles.css') }}" rel="stylesheet">

  {% set globalScripts = siteSettings.scripts.all %}
  {% include '_shared/globalScripts' with {globalScripts: globalScripts, position: 'head'} %}

</head>
<body {%- if bodyClass is defined %} class="{{ bodyClass }}"{% endif %}>
  {% include '_shared/globalScripts' with {globalScripts: globalScripts, position: 'bodyBegin'} %}
  <a href="#main-content-start" class="sr-only sr-only-focusable" title="Skip over the navigation directly to main content of the page">Skip to main content</a>
  {% block pageLayout %}
  {% endblock %}
  {% include '_shared/adminPanel' %}

  {# Hyperscript #}
  <script src="https://unpkg.com/hyperscript.org@0.9.5"></script>

  {# jQuery v1.11.2 from Google CDN #}
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.2/jquery.min.js"></script>
  {# Compiled and minified Bootstrap JavaScript v3.3.5 #}
  <script src="//d3gex2kmk7v5nh.cloudfront.net/bootstrap/js/bootstrap2018.min.js"></script>

  {# Minified Swiper JavaScript v4.0.5 #}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/3.4.2/js/swiper.min.js"></script>

  {# Custom Js Files #}
  <script src="{{ craft.tungsten.assetUrl('scripts.js') }}"></script>

  {# Include all JS collected through 'js' and 'view.registerJsFile(url)' #}
  {{ endBody() }}

  {% include '_shared/globalScripts' with {globalScripts: globalScripts, position: 'bodyEnd'} %}
</body>
</html>
