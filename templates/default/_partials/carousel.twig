{% set slides = entry.carousel.all %}

<!-- Slider main container -->
<div class="hp-swiper swiper-container">
    <!-- Additional required wrapper -->
    <div class="swiper-wrapper">
        <!-- Slides -->
        {% for slide in slides %}
          <div class="swiper-slide">
            {% if slide.title|length %}
              <div class="nadpis">
                <h2>
                  {{ slide.title }}
                </h2>
                {% if slide.kratkyPopis|length %}
                  <p>{{ slide.kratkyPopis }}</p>
                {% endif %}
                <div class="btn-wrap">
                  <a href="{{ slide.tlacitko }}" class="btn">{{ slide.tlacitko.label }}</a>
                </div>
              </div>
            {% endif %}
            {% if slide.obrazok|length %}
              <div class="obrazok">
                <img src="{{ slide.obrazok.one.url('heroImages') }}" alt="{{ slide.title }}">
              </div>
            {% endif %}
          </div>
        {% endfor %}
    </div>

    <!-- If we need navigation buttons -->
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
 </div>
