{% set transform = block.imageSize.value %}

{% set pageWidth = '970' %}

{% set image = block.image.one %}

<div class="image img-responsive {{ block.alignment }} {{ block.imageSize.value }}" style="max-width:{{ image.width > image.getWidth(transform) ? image.getWidth(transform) : image.width }}px;">
  {% if block.imageLink is not empty %}
    <a href="{{ block.imageLink }}" title="{{ image.title }}">
  {% endif %}
    <img class="img-thumbnail img-responsive" src="{{ image.width > image.getWidth(transform) ? image.url(transform) : image.url() }}" alt="{{ image.title }}" />
  {% if block.imageLink is not empty %}
    </a>
  {% endif %}
  {% if block.caption is not empty %}
    <p class="caption">{{ block.caption }}</p>
  {% endif %}
</div>
