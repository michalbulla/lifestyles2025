<header>
  <div class="header-overlay">
    <div class="container">
      <div class="header-container">
        <div class="header-block">
          <div class="logo"><a class="logo-subpage" href="/" title="Back to Home Page"><img src="/img/logo-dark.png" alt="{{ siteName }}" /></a><a class="logo-homepage" href="/" title="Back to Home Page"><img src="/img/logo.png" alt="{{ siteName }}" /></a></div>
          {% include '_partials/nav/main' %}
          <button type="button" aria-label="Main Navigation Toggle" title="Main Navigation Toggle" aria-haspopup="true" aria-controls="main-nav" aria-expanded="false" class="main-nav-toggle" id="main-nav-toggle">
            <i class="fa fa-bars"></i>
          </button>
        </div>
      </div>
    </div>
    {% if entry.slug == 'home-page' %}
      {% include "_partials/carousel" %}
      <a href="" class="btn start-btn"><i class="fa fa-angle-double-down"></i></a>
    {% endif %}
  </div>
</header>
